{
  "extends": ["expo/tsconfig.base.json", "../../../tsconfig.effect.json"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        // React Native has no Effect platform layer. Effect-style suggestions stay off, as in the board.
        "diagnosticSeverity": {
          "effectFnOpportunity": "off",
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off"
        }
      }
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
